# OpenSSL configuration for the internal timestamp authority (TSA)
# used by issue-tsa-cert.sh and by "openssl ts -reply".
#
# The TSA working directory is read from the TSA_DIR environment
# variable. issue-tsa-cert.sh and the adapters that spawn openssl
# export TSA_DIR before invoking it, so this file is not meant to be
# used standalone. The TSA working directory holds the signer private
# key and must never be committed to version control.

[ tsa ]
default_tsa = internal_tsa

[ internal_tsa ]
# Layout of the runtime TSA working directory, as prepared by
# issue-tsa-cert.sh.
dir          = $ENV::TSA_DIR
serial       = $dir/serial
signer_key   = $dir/private/tsa.key.pem
signer_cert  = $dir/tsa.crt.pem
# Certificates appended to every response so a verifier can build the
# chain from the signer up to the root; issue-tsa-cert.sh copies the
# root certificate here.
certs        = $dir/tsa-chain.pem

# All digests are SHA-256: the imprint digests accepted in requests and
# the digest used for the response signature.
digests       = sha256
signer_digest = sha256

# Policy identifier stamped into every token. The arc 1.3.6.1.4.1 is
# the IANA private-enterprise tree; the value below is a demo policy
# for this prototype, not a registered production policy. Requests
# asking for any other policy are refused.
default_policy = 1.3.6.1.4.1.13762.3

# The asserted time is accurate to one second and responses carry no
# ordering guarantee between tokens.
accuracy = secs:1
ordering = no

# Keep responses minimal: no TSA name and no ESS certificate chain
# inside the signed attributes.
tsa_name          = no
ess_cert_id_chain = no

[ v3_tsa ]
# Extensions for the TSA signer certificate, applied by
# issue-tsa-cert.sh through "openssl ca -extfile ... -extensions
# v3_tsa". RFC 3161 requires the extendedKeyUsage of a timestamping
# certificate to be critical and to contain id-kp-timeStamping.
basicConstraints        = critical, CA:false
keyUsage                = critical, digitalSignature
extendedKeyUsage        = critical, timeStamping
authorityKeyIdentifier  = keyid:always
subjectKeyIdentifier    = hash
