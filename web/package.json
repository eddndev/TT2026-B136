{
  "name": "qadra-web-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @qadra/desk --",
    "build": "npm run build --workspace @qadra/desk --",
    "preview": "npm run preview --workspace @qadra/desk --",
    "dev:ca": "npm run dev --workspace @qadra/ca --",
    "build:ca": "npm run build --workspace @qadra/ca --",
    "preview:ca": "npm run preview --workspace @qadra/ca --",
    "test:ca": "npm test --workspace @qadra/ca --",
    "test": "npm test --workspace @qadra/desk --",
    "test:e2e": "npm run test:e2e --workspace @qadra/desk --",
    "format": "prettier --write apps/qadra/src apps/qadra/tests apps/qadra/*.mjs apps/qadra/svelte.config.js packages/ui/src",
    "format:check": "prettier --check apps/qadra/src apps/qadra/tests apps/qadra/*.mjs apps/qadra/svelte.config.js packages/ui/src"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^1.0.0",
    "prettier-plugin-svelte": "^4.1.1"
  }
}
