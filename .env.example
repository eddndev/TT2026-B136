# .env.example -- template of the environment variables the software reads.
#
# Copy this file to .env and adjust the values locally. The real .env is
# never committed to version control. Variables left blank below are
# secrets and must be filled in locally before use.

# Log filter directive for tracing output (error, warn, info, debug, trace).
RUST_LOG=info

# Optional external timestamp authority. The local HTTP application does not
# require it and uses the local OpenSSL TSA configured by the serve command.
CINCEL_BASE_URL=

# API key for the timestamp authority (secret: fill in locally).
CINCEL_API_KEY=

# Postgres connection string for the application database.
DATABASE_URL=postgres://despacho:CHANGE_ME@localhost:5432/despacho

# Redis connection string for revocable sessions and short-lived challenges.
REDIS_URL=redis://localhost:6379/

# Key-encrypting key: 32 random bytes encoded in base64 (secret: fill in
# locally). Generate one with: openssl rand -base64 32
KEK_BASE64=

# Replacement key-encrypting key, read only by `vault rotate-kek` (secret:
# fill in locally just before a rotation, then move it into KEK_BASE64 once
# every package has been rewrapped).
NEW_KEK_BASE64=

# Audit trail file. Defaults to audit-log.jsonl in the working directory.
AUDIT_LOG_PATH=audit-log.jsonl

# Working directory of the internal certificate authority. Defaults to
# pki-ca under the working directory; keep it outside any repository
# checkout because it holds private key material.
PKI_CA_DIR=

# Working directory of the local timestamp authority. Defaults to pki-tsa
# next to PKI_CA_DIR; it also holds private key material.
TSA_DIR=

# Password recovery remains disabled until its operational policy is approved.
# Complete activation and restore requirements: docs/password-reset-public.md.
TT_PASSWORD_RESET_ENABLED=false
# The secret is shared by explicitly configured email channels; it enables none.
# RESEND_API_KEY=
# Every recovery setting below is required when recovery is enabled.
# TT_PASSWORD_RESET_EMAIL_FROM=
# TT_PASSWORD_RESET_PUBLIC_URL=
# TT_PASSWORD_RESET_TTL_SECONDS=
# TT_PASSWORD_RESET_MAX_PENDING=
# TT_PASSWORD_RESET_REQUEST_GLOBAL_MAX=
# TT_PASSWORD_RESET_REQUEST_GLOBAL_WINDOW_SECONDS=
# TT_PASSWORD_RESET_REQUEST_EMAIL_MAX=
# TT_PASSWORD_RESET_REQUEST_EMAIL_WINDOW_SECONDS=
# TT_PASSWORD_RESET_COMPLETE_GLOBAL_MAX=
# TT_PASSWORD_RESET_COMPLETE_GLOBAL_WINDOW_SECONDS=
# TT_PASSWORD_RESET_COMPLETE_TOKEN_MAX=
# TT_PASSWORD_RESET_COMPLETE_TOKEN_WINDOW_SECONDS=
# TT_PASSWORD_RESET_REDIS_CONNECT_MS=
# TT_PASSWORD_RESET_REDIS_IO_MS=
# TT_PASSWORD_RESET_EMAIL_CONNECT_MS=
# TT_PASSWORD_RESET_EMAIL_TOTAL_MS=
