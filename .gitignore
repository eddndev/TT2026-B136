# Rust build artifacts
/target
**/*.rs.bk

# Environment and secrets
.env
.env.*
!.env.example

# Private key material and generated crypto artifacts (never commit)
pki/**/*.key
pki/**/*.pem
!pki/**/ca-chain.example.pem
# Runtime working directories of the internal CA and the local TSA
# (created by pki/init-ca.sh and pki/issue-tsa-cert.sh when run from
# the repository root with default paths).
pki-ca/
pki-tsa/
runtime-data/
*.tsr
*.enc
*.sig
# Public test fixtures generated from an ephemeral PKI by
# scripts/evidence-verify-fixtures.sh; they hold no private material.
!crates/evidence-verify/tests/fixtures/*.tsr
!crates/evidence-verify/tests/fixtures/*.sig

# Node / frontend
node_modules
archive/frontend-prototype/dist
archive/frontend-prototype/.astro

# Generated document delivery packages
/output/

# Local temporary presentation; preserve files outside version control.
/presentacion/

# Editor and OS noise
.DS_Store
*.swp
