# Rust build artifacts
/target
**/*.rs.bk

# Environment and secrets
.env
.env.*
!.env.example

# Private key material and generated crypto artifacts (never commit)
pki/**/*.key
pki/**/*.pem
!pki/**/ca-chain.example.pem
# Runtime working directories of the internal CA and the local TSA
# (created by pki/init-ca.sh and pki/issue-tsa-cert.sh when run from
# the repository root with default paths).
pki-ca/
pki-tsa/
runtime-data/
*.tsr
*.enc
*.sig

# Node / frontend
node_modules
frontend/dist
frontend/.astro

# Editor and OS noise
.DS_Store
*.swp
